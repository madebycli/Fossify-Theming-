<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.fossify.android.permission.WRITE_GLOBAL_SETTINGS" />

    <!--
        Stock Fossify apps already request this permission through Commons.
        The compatibility flavor defines it as normal so official Fossify APKs,
        which are signed with a different key than this local fork, can still
        read the legacy provider. The provider still validates known Fossify callers.
    -->
    <permission
        android:name="org.fossify.android.permission.WRITE_GLOBAL_SETTINGS"
        android:protectionLevel="normal" />

    <application
        android:label="@string/app_brand_name"
        tools:replace="android:label">

        <provider
            android:name="org.fossify.thankyou.contentproviders.MyContentProvider"
            android:permission="org.fossify.android.permission.WRITE_GLOBAL_SETTINGS" />

        <activity-alias
            android:name=".activities.SplashActivity.Green"
            android:enabled="false"
            tools:replace="android:enabled" />

        <activity-alias
            android:name=".activities.SplashActivity.Grey_black"
            android:enabled="true"
            tools:replace="android:enabled" />
    </application>
</manifest>
